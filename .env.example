# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/anargya_db?schema=public"
# Non-pooled connection for migrations/seeding. With a pooled provider (e.g. Neon, Supabase),
# point this at the direct (non-pooling) connection string; otherwise it can match DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/anargya_db?schema=public"

# Admin dashboard credentials (/admin) — override in production, never commit real values.
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"
ADMIN_SECRET="change-me-too-a-long-random-string"
